{
  "info": {
    "_postman_id": "c8a41065-bf02-4293-8b7c-3f2d0f52219e",
    "name": "Todolist RESTful API (OpenAPI PZN)",
    "description": "Postman Collection for Todolist RESTful API based on Programmer Zaman Now OpenAPI Tutorial",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "rahasia",
      "type": "string"
    },
    {
      "key": "todolistId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Todolist (Java)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.id) {",
              "    pm.collectionVariables.set(\"todolistId\", jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Java\",\n  \"priority\": 3,\n  \"tags\": [\n    \"Java\",\n    \"Programming\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todolist",
          "host": ["{{baseUrl}}"],
          "path": ["todolist"]
        }
      }
    },
    {
      "name": "2. Create Todolist (PHP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"PHP\",\n  \"priority\": 5,\n  \"tags\": [\n    \"PHP\",\n    \"Programming\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todolist",
          "host": ["{{baseUrl}}"],
          "path": ["todolist"]
        }
      }
    },
    {
      "name": "3. Get All Todolist",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todolist",
          "host": ["{{baseUrl}}"],
          "path": ["todolist"]
        }
      }
    },
    {
      "name": "4. Filter Todolist by Name",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todolist?name=Java",
          "host": ["{{baseUrl}}"],
          "path": ["todolist"],
          "query": [
            {
              "key": "name",
              "value": "Java"
            }
          ]
        }
      }
    },
    {
      "name": "5. Update Existing Todolist",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Java Advanced\",\n  \"priority\": 4,\n  \"tags\": [\n    \"Java\",\n    \"Backend\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todolist/{{todolistId}}",
          "host": ["{{baseUrl}}"],
          "path": ["todolist", "{{todolistId}}"]
        }
      }
    },
    {
      "name": "6. Delete Existing Todolist",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todolist/{{todolistId}}",
          "host": ["{{baseUrl}}"],
          "path": ["todolist", "{{todolistId}}"]
        }
      }
    },
    {
      "name": "7. Delete Todolist (Not Found - 404)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todolist/99999",
          "host": ["{{baseUrl}}"],
          "path": ["todolist", "99999"]
        }
      }
    },
    {
      "name": "8. Unauthorized Test (Without API Key)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todolist",
          "host": ["{{baseUrl}}"],
          "path": ["todolist"]
        }
      }
    }
  ]
}
